rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Itineraries collection
    match /itineraries/{itineraryId} {
      // Allow authenticated users to create itineraries with their own userId
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Allow users to read their own itineraries
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // Allow users to update their own itineraries (userId cannot be changed)
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      
      // Allow users to delete their own itineraries
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // Guides collection
    match /guides/{guideId} {
      // Allow anyone to read guides
      allow read: if true;
      
      // Allow authenticated users to create guides
      allow create: if isAuthenticated();
      
      // Allow users to update/delete their own guides
      allow update, delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // Experiences collection
    match /experiences/{experienceId} {
      // Allow anyone to read experiences
      allow read: if true;
      
      // Allow authenticated users to create experiences
      allow create: if isAuthenticated();
      
      // Allow users to update/delete their own experiences
      allow update, delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

